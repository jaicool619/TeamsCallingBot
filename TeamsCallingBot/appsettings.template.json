{
  "Bot": {
    "AadAppId": "YOUR_AZURE_AD_APP_ID",
    "AadTenantId": "YOUR_AZURE_AD_TENANT_ID",
    "AadAppSecretOrCertThumbprint": "YOUR_AZURE_AD_APP_SECRET_OR_CERT_THUMBPRINT",
    "TranscriptOutputFolder": "",
    "PlaceCallEndpointUrl": "https://graph.microsoft.com/v1.0",
    "ServiceDnsName": "your-service-dns-name.example.com",
    "InstancePublicIpAddress": "YOUR_PUBLIC_IP",
    "InstancePublicPort": 443,
    "MediaInstanceInternalPort": 65000,
    "MediaInstancePublicPort": 65000,
    "CertificateThumbprint": "YOUR_CERTIFICATE_THUMBPRINT",
    "MaxConcurrentCalls": 5,
    "TestMeetingJoinUrl": "",
    "TestMeetingJoinUrls": [
      "https://teams.microsoft.com/l/meetup-join/MEETING_1_PLACEHOLDER",
      "https://teams.microsoft.com/l/meetup-join/MEETING_2_PLACEHOLDER",
      "https://teams.microsoft.com/l/meetup-join/MEETING_3_PLACEHOLDER",
      "https://teams.microsoft.com/l/meetup-join/MEETING_4_PLACEHOLDER",
      "https://teams.microsoft.com/l/meetup-join/MEETING_5_PLACEHOLDER"
    ],
    "OverrideBearerToken": "",

    "StartMuted": true,
    "SpeakGreetingOnJoin": false,
    "GreetParticipantsByName": false,
    "AnnounceScreenShare": false,

    "WhisperExecutablePath": "C:\\whisper\\whisper-cli.exe",
    "WhisperModelPath": "C:\\whisper\\models\\ggml-base.bin",
    "WhisperLanguage": "auto",
    "WhisperPrompt": "Meeting conversation in English, Hindi, and Hinglish: Namaste, haan, theek hai, okay, right, discuss karte hain.",
    "WhisperBeamSize": 5,

    "RecordScreenShare": true,
    "RecordParticipantVideo": true,
    "ScreenShareRecordingFps": 5,
    "ParticipantVideoRecordingFps": 3,
    "VideoJpegQuality": 75,
    "SnapshotIntervalSeconds": 10,
    "MaxVideoSegmentBytes": 1500000000,
    "FfmpegPath": "",

    "GreetingText": "Hello everyone, I am the AI meeting assistant. I have joined to record this meeting and prepare the minutes.",
    "TtsCulture": "en-IN",
    "TtsVoiceName": "",
    "TtsVoiceGender": "Female",

    "UseBotFrameworkForChat": true,
    "BotFrameworkServiceUrl": "https://smba.trafficmanager.net/teams/",

    "Mom": {
      "GenerateWordDocument": true,
      "AnthropicApiKey": "",
      "Model": "claude-opus-5",
      "MaxSnapshotsForAi": 12,
      "Language": "English",
      "OrganizationName": "",
      "EmbedSnapshots": true,
      "MaxSnapshotsInDocument": 20,
      "RequestTimeoutSeconds": 600,
      "Enabled": true
    },

    "Gcs": {
      "Enabled": false,
      "BucketName": "YOUR_GCS_BUCKET_NAME",
      "ServiceAccountKeyPath": "C:\\secrets\\gcs-service-account.json",
      "ObjectPathTemplate": "meetings/{ChatThreadId}/{CallId}/08_minutes_of_meeting.docx",
      "SignedUrlExpiryHours": 168
    },

    "PowerAutomate": {
      "Enabled": false,
      "FlowUrl": "YOUR_POWER_AUTOMATE_HTTP_TRIGGER_URL",
      "RequestTimeoutSeconds": 30
    },

    "Tda": {
      "Enabled": false,
      "BaseUrl": "",
      "TokenEndpoint": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scope": "",
      "QueryEndpointPath": "/query",
      "MessageEndpointPath": "/message",
      "RequestTimeoutSeconds": 30,
      "MaxSpokenAnswerChars": 600
    }
  }
}
